# ---------------------------------------------------------------------------
# KALIKA AI — Frontend environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings → API).
#
# IMPORTANT: Only the *anon / publishable* key belongs here. It is designed to
# be public and is protected by Row Level Security. NEVER put the
# `service_role` key, database passwords, or any private API key in the
# frontend — anything prefixed with VITE_ is bundled into the client.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Base URL of the KALIKA AI backend (Render). Used by the API client.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public origin of this app. Must match the dev server host/port below and be
# listed in Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_APP_URL=http://kalika.localhost:4300
